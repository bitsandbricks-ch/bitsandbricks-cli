# Mortar settings for deploy/docker-compose.yml. Copy to .env (never commit it). All settings: docs/mortar.md.

# Image tag: a release (1.2.3, 1.2, latest) or main (the newest build of main).
MTR_TAG=main

# Where people reach Mortar. Must be https:// (MTR_DEV is forced off in compose).
MTR_URL=https://mortar.example.com
# A long random string (openssl rand -base64 48). Without it Mortar makes one in the data volume.
MTR_SECRET_KEY=
# The Postgres password, letters and digits only (openssl rand -hex 24); the database is only reachable inside compose.
POSTGRES_PASSWORD=

# GitHub OAuth app: callback https://mortar.example.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub Enterprise: GITHUB_URL=https://github.example.com

# GitLab application (confidential, scope api): callback https://mortar.example.com/api/v1/auth/gitlab/callback
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Self-managed GitLab: GITLAB_URL=https://gitlab.example.com

# Admins (github:login, gitlab:login, or a bare login). Admins may always sign in.
MTR_ADMINS=github:you

# Who else may sign in (optional; leave all unset for admins only).
# MTR_ALLOW_USERS=github:ann, gitlab:bob
# MTR_ALLOW_ORGS=github:your-org, gitlab:your-group
# MTR_ALLOW_ANYONE=1        # any GitHub/GitLab account may sign in

# Proxies in front that set X-Forwarded-* (compose default 1).
# MTR_TRUSTED_PROXIES=1
