# Where people reach Mortar (https only, unless BNB_OPERATOR_DEV=1).
BNB_OPERATOR_URL=https://mortar.example.com
# A long random string; without it Mortar makes one in /data/secret.key.
BNB_OPERATOR_SECRET_KEY=

# GitHub OAuth app: callback https://mortar.example.com/api/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub Enterprise: GITHUB_URL=https://github.example.com

# GitLab application: callback https://mortar.example.com/api/v1/auth/gitlab/callback, scope api
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# GITLAB_URL=https://gitlab.example.com

# Who may sign in (github:login, gitlab:login, or a bare login), and who is admin.
BNB_OPERATOR_ALLOW_ORGS=github:your-org
BNB_OPERATOR_ALLOW_USERS=
BNB_OPERATOR_ADMINS=github:you
